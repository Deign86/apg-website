php_value date.timezone 'Asia/Manila'

# Never serve dotfiles (.env holds DB/SMTP credentials).
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Keep the admin panel out of search engines (SPA route, so match the original URI;
  # after the index.html rewrite Apache exposes the flag as REDIRECT_NOINDEX).
  SetEnvIf Request_URI "^/admin" NOINDEX
  Header always set X-Robots-Tag "noindex, nofollow" env=NOINDEX
  Header always set X-Robots-Tag "noindex, nofollow" env=REDIRECT_NOINDEX
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # The SPA shell must always be revalidated so browsers never keep an index.html that
  # points at bundles from a previous deploy. Hashed build files never change, so cache them hard.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Bot protection (site-wide): refuse requests with no browser identity, scripted HTTP
  # clients, vulnerability scanners and abusive SEO scrapers. Search engines, social
  # previews and AI assistants (llms.txt) are untouched. This site is not WordPress, so
  # WordPress login/xmlrpc probes are refused outright instead of getting the SPA shell.
  RewriteCond %{HTTP_USER_AGENT} ^-?$ [OR]
  RewriteCond %{HTTP_USER_AGENT} (python-requests|python-urllib|aiohttp|httpx|Go-http-client|libwww-perl|Scrapy|curl/|Wget|PhantomJS|masscan|zgrab|nikto|sqlmap|nuclei) [NC,OR]
  RewriteCond %{HTTP_USER_AGENT} (AhrefsBot|SemrushBot|MJ12bot|DotBot|PetalBot|Bytespider|BLEXBot|DataForSeoBot|MegaIndex|serpstatbot|SeekportBot) [NC,OR]
  RewriteCond %{REQUEST_URI} (wp-login\.php|xmlrpc\.php|wp-admin|wp-includes) [NC]
  RewriteRule ^ - [F,L]

  # Redirect all plain HTTP traffic to HTTPS before serving files or SPA routes.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 1. Allow direct access to API PHP endpoints and static assets
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 1b. A missing build/static file is a real 404 — never the HTML shell, which browsers
  #     would reject as a script/stylesheet ("MIME type text/html") and render a blank page.
  RewriteRule ^(assets|images|imports|fonts|legacy)/ - [R=404,L]

  # 2. Clean URL rewrite for /api/*.php if requested without .php extension
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^api/(.*)$ api/$1.php [L,QSA]

  # 3. Route all other frontend SPA requests to index.html
  RewriteRule ^ index.html [L]
</IfModule>

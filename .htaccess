php_value date.timezone 'Asia/Manila'

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect all plain HTTP traffic to HTTPS before serving files or SPA routes.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 1. Allow direct access to API PHP endpoints and static assets
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Clean URL rewrite for /api/*.php if requested without .php extension
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^api/(.*)$ api/$1.php [L,QSA]

  # 3. Route all other frontend SPA requests to index.html
  RewriteRule ^ index.html [L]
</IfModule>

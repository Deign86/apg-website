# Alpha Premier Group — Hostinger deployment target
#
# Copy this file to `.env.deploy` and fill in the real values.
# `.env.deploy` is git-ignored. Never commit real credentials.
#
# Find these in Hostinger hPanel:
#   Host     -> the server IP shown under "SSH Access" / "FTP Accounts"
#   Port     -> 65002 is Hostinger's standard SFTP port (not 22)
#   User     -> your hosting username, e.g. u123456789
#   Path     -> absolute path to the web root, usually /home/u123456789/public_html

# === SFTP connection ===
SFTP_HOST=
SFTP_PORT=65002
SFTP_USER=
SFTP_PATH=/home/u123456789/public_html

# === Authentication (pick ONE) ===
# Option A: password auth. Leave blank to be prompted interactively each deploy
# (recommended — nothing sensitive is written to disk).
SFTP_PASSWORD=

# Option B: key auth. Path to a private key on this machine.
SFTP_KEY=

# === Deploy behaviour ===
# Set to "1" to upload without the dry-run summary prompt.
DEPLOY_YES=0

# Set to "1" to skip `npm run build` and deploy the existing dist/ as-is.
SKIP_BUILD=0

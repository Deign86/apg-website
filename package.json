{
  "name": "alpha-premier-group",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Alpha Premier Group — Vite + React SPA on Native PHP + MySQL Backend",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "deploy": "node tools/deploy-hostinger.mjs",
    "deploy:dry": "node tools/deploy-hostinger.mjs --dry-run",
    "clean": "node tools/auto-clean.mjs --force",
    "clean:auto": "node tools/auto-clean.mjs",
    "test": "node tests/run-all.mjs",
    "test:unit": "node --import ./tests/support/unit-register.mjs --test --test-reporter=spec \"tests/unit/**/*.test.mjs\" src/routes/admin/__tests__/site-alignment.test.mjs",
    "test:api": "node tests/run-api.mjs",
    "test:e2e": "playwright test",
    "test:update-snapshots": "playwright test visual --update-snapshots"
  },
  "dependencies": {
    "aos": "^2.3.4",
    "dompurify": "^3.4.16",
    "dotenv": "^16.4.7",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.487.0",
    "motion": "^12.23.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.55.0",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.9.1",
    "tw-animate-css": "^1.3.8"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.79.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.3",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.6.3",
    "vite": "^7.3.6"
  }
}

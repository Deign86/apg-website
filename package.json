{
  "name": "alpha-premier-group",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Alpha Premier Group — Vite + React SPA (migrated from Firebase to Supabase)",
  "scripts": {
    "dev": "concurrently --kill-others \"vite\" \"node server/contact.js\"",
    "dev:contact": "node server/contact.js",
    "dev:all": "concurrently --kill-others \"pnpm dev\" \"pnpm dev:contact\"",
    "build": "vite build",
    "preview": "vite preview",
    "migrate-to-supabase": "node scripts/migrate-to-supabase.cjs || supabase db push",
    "setup-admin": "node scripts/setup-admin.cjs",
    "seed-archived-context": "node scripts/seed-archived-context.mjs",
    "seed-job-openings": "node scripts/seed-job-openings.mjs",
    "update-contact-info": "node scripts/update-contact-info.mjs",
    "test": "node --test scripts/**/*.test.cjs server/**/*.test.mjs",
    "verify:env": "node scripts/verify-env.mjs",
    "verify:api": "node scripts/verify-api-contracts.mjs",
    "verify:supabase": "node scripts/verify-supabase.mjs",
    "verify:vercel": "node scripts/verify-vercel.mjs",
    "verify:e2e": "node scripts/e2e-smoke.mjs",
    "check:assets": "node scripts/asset-health-check.cjs",
    "check:guardrails": "node scripts/check-asset-guardrails.cjs",
    "ingest:listings": "node scripts/ingest-apg-listings.cjs",
    "lint": "oxlint"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "aos": "^2.3.4",
    "dotenv": "^16.4.7",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.487.0",
    "motion": "^12.23.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.55.0",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "7.18.1",
    "recharts": "^3.9.1",
    "resend": "^6.16.0",
    "tus-js-client": "^4.3.1",
    "tw-animate-css": "^1.3.8"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.79.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.3",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.6.3",
    "vite": "^7.3.6"
  }
}

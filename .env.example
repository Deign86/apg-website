# Alpha Premier Group — Environment Configuration Template
# Copy this file to .env or .env.local and fill in real values.
# .env and .env.local are git-ignored and hold your secrets.

# === Database Configuration (MySQL / MariaDB) ===
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=apg_website
DB_USER=root
DB_PASS=

# === One-shot migration utilities ===
# Required by api/setup.php and api/migrate.php when invoked over HTTP.
# Without this set, both endpoints return 404 for every web request.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETUP_TOKEN=

# Password for the initial admin account created by api/setup.php.
# Required (12+ characters) when setup.php has to create the admin account; change it after first login.
ADMIN_DEFAULT_PASSWORD=

# === SMTP / Email Configuration (Titan Email / Hostinger) ===
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=inquiries@alphapremiergroup.com
SMTP_PASS=your_smtp_password_here
MAIL_FROM_EMAIL=inquiries@alphapremiergroup.com
MAIL_FROM_NAME="Alpha Premier Group"
MAIL_TO_EMAIL=inquiries@alphapremiergroup.com

# === Optional Google Analytics 4 (leave blank to disable) ===
VITE_ANALYTICS_ID=



# === Gemini AI (website chatbot + ATS). Leave the key blank to disable AI and use the FAQ bot. ===
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Site-wide cap on AI chat replies per 24h (protects the free Gemini quota); FAQ answers continue after.
GEMINI_DAILY_LIMIT=800

# === Applicant screening (ATS) ===
# Shortlist emails and the daily digest (api/cron/ats-digest.php) go to HR_EMAIL.
# Applicants scoring >= ATS_THRESHOLD (0-100) are shortlisted and emailed immediately.
# ATS_USE_AI=1 scores with Gemini (needs GEMINI_API_KEY); keyword rules are the fallback.
HR_EMAIL=hrjheane@gmail.com
ATS_THRESHOLD=70
ATS_USE_AI=0

# Alpha Premier Group — Environment Configuration Template
# Copy this file to .env or .env.local and fill in real values.
# .env and .env.local are git-ignored and hold your secrets.

# === Database Configuration (MySQL / MariaDB) ===
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=apg_website
DB_USER=root
DB_PASS=

# === One-shot migration utilities ===
# Required by api/setup.php and api/migrate-blogs.php when invoked over HTTP.
# Without this set, both endpoints return 404 for every web request.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETUP_TOKEN=

# Password for the initial admin account created by api/setup.php.
# Leave blank to fall back to the built-in default, then change it on first login.
ADMIN_DEFAULT_PASSWORD=

# === SMTP / Email Configuration (Titan Email / Hostinger) ===
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=inquiries@alphapremiergroup.com
SMTP_PASS=your_smtp_password_here
MAIL_FROM_EMAIL=inquiries@alphapremiergroup.com
MAIL_FROM_NAME="Alpha Premier Group"
MAIL_TO_EMAIL=inquiries@alphapremiergroup.com

# === Optional Google Analytics 4 (leave blank to disable) ===
VITE_ANALYTICS_ID=


